{
  "name": "paralog",
  "version": "0.0.1",
  "description": "Finds duplicated business logic and overlapping responsibilities in TypeScript repositories, even when the code is written differently.",
  "keywords": [
    "typescript",
    "duplication",
    "static-analysis",
    "mcp",
    "code-quality",
    "llm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flgisimone/paralog.git"
  },
  "homepage": "https://github.com/flgisimone/paralog#readme",
  "bugs": "https://github.com/flgisimone/paralog/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "paralog": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepack": "npm run build",
    "smoke": "node scripts/smoke.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^22.19.0",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "rollup": "^4.67.2",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
